{
  "_comment": "Cross-SDK expression parity fixtures; expected values use 6dp HALF_UP accounting precision.",
  "expression_cases": [
    {
      "name": "linear_input",
      "expr": "input_tokens * 0.001",
      "vars": {
        "input_tokens": 1000
      },
      "expected": "1.000000"
    },
    {
      "name": "floor_div_negative_truncates_toward_zero",
      "expr": "(input_tokens - 1000) // 2",
      "vars": {
        "input_tokens": 993
      },
      "expected": "-3.000000"
    },
    {
      "name": "floor_div_positive",
      "expr": "input_tokens // 3",
      "vars": {
        "input_tokens": 7
      },
      "expected": "2.000000"
    },
    {
      "name": "chained_comparison_rejected",
      "expr": "1 < input_tokens < 100",
      "vars": {
        "input_tokens": 50
      },
      "expect_error": true
    },
    {
      "name": "two_term_rate",
      "expr": "input_tokens * (0.01 / 1000) + output_tokens * (0.03 / 1000)",
      "vars": {
        "input_tokens": 500,
        "output_tokens": 200
      },
      "expected": "0.011000"
    },
    {
      "name": "decimal_precision",
      "expr": "input_tokens * 0.1 + output_tokens * 0.2",
      "vars": {
        "input_tokens": 1,
        "output_tokens": 1
      },
      "expected": "0.300000"
    },
    {
      "name": "sub_one_credit_not_truncated",
      "expr": "input_tokens * 0.0004",
      "vars": {
        "input_tokens": 1000
      },
      "expected": "0.400000"
    },
    {
      "name": "min",
      "expr": "min(input_tokens, 100)",
      "vars": {
        "input_tokens": 500
      },
      "expected": "100.000000"
    },
    {
      "name": "max",
      "expr": "max(input_tokens, 100)",
      "vars": {
        "input_tokens": 50
      },
      "expected": "100.000000"
    },
    {
      "name": "clamp_high",
      "expr": "clamp(input_tokens, 0, 100)",
      "vars": {
        "input_tokens": 500
      },
      "expected": "100.000000"
    },
    {
      "name": "clamp_low",
      "expr": "clamp(input_tokens, 0, 100)",
      "vars": {
        "input_tokens": -5
      },
      "expected": "0.000000"
    },
    {
      "name": "if_true",
      "expr": "if(input_tokens > 100, 5, 1)",
      "vars": {
        "input_tokens": 200
      },
      "expected": "5.000000"
    },
    {
      "name": "if_false",
      "expr": "if(input_tokens > 100, 5, 1)",
      "vars": {
        "input_tokens": 50
      },
      "expected": "1.000000"
    },
    {
      "name": "tier_first",
      "expr": "tier(input_tokens, 100, 1, 500, 2, 3)",
      "vars": {
        "input_tokens": 50
      },
      "expected": "1.000000"
    },
    {
      "name": "tier_middle",
      "expr": "tier(input_tokens, 100, 1, 500, 2, 3)",
      "vars": {
        "input_tokens": 300
      },
      "expected": "2.000000"
    },
    {
      "name": "tier_default",
      "expr": "tier(input_tokens, 100, 1, 500, 2, 3)",
      "vars": {
        "input_tokens": 1000
      },
      "expected": "3.000000"
    },
    {
      "name": "tier_single_pair_default",
      "expr": "tier(input_tokens, 100, 1, 9)",
      "vars": {
        "input_tokens": 150
      },
      "expected": "9.000000"
    },
    {
      "name": "tier_single_pair_hit",
      "expr": "tier(input_tokens, 100, 1, 9)",
      "vars": {
        "input_tokens": 50
      },
      "expected": "1.000000"
    },
    {
      "name": "ceil",
      "expr": "ceil(input_tokens * 0.0011)",
      "vars": {
        "input_tokens": 1000
      },
      "expected": "2.000000"
    },
    {
      "name": "floor",
      "expr": "floor(input_tokens * 0.0019)",
      "vars": {
        "input_tokens": 1000
      },
      "expected": "1.000000"
    },
    {
      "name": "round_half_up",
      "expr": "round(input_tokens * 0.0025)",
      "vars": {
        "input_tokens": 1000
      },
      "expected": "3.000000"
    },
    {
      "name": "div_by_zero",
      "expr": "1 / 0",
      "vars": {},
      "expect_error": true
    },
    {
      "name": "mod_by_zero",
      "expr": "input_tokens % 0",
      "vars": {
        "input_tokens": 5
      },
      "expect_error": true
    },
    {
      "name": "pow_rejected",
      "expr": "2 ** 3",
      "vars": {},
      "expect_error": true
    },
    {
      "name": "pow_bomb_rejected",
      "expr": "9 ** 9 ** 9",
      "vars": {},
      "expect_error": true
    },
    {
      "name": "unknown_variable_typo",
      "expr": "inputtokens * 0.001",
      "vars": {
        "input_tokens": 1000
      },
      "expect_error": true
    },
    {
      "name": "proto_identifier_rejected",
      "expr": "__proto__ * 1",
      "vars": {
        "input_tokens": 1
      },
      "expect_error": true
    },
    {
      "name": "constructor_identifier_rejected",
      "expr": "constructor + input_tokens",
      "vars": {
        "input_tokens": 1
      },
      "expect_error": true
    },
    {
      "name": "attribute_access_rejected",
      "expr": "input_tokens.__class__",
      "vars": {
        "input_tokens": 1
      },
      "expect_error": true
    },
    {
      "name": "clamp_wrong_arity",
      "expr": "clamp(input_tokens)",
      "vars": {
        "input_tokens": 1
      },
      "expect_error": true
    },
    {
      "name": "if_wrong_arity",
      "expr": "if(input_tokens > 0, 5)",
      "vars": {
        "input_tokens": 1
      },
      "expect_error": true
    },
    {
      "name": "tier_odd_arity",
      "expr": "tier(input_tokens, 100, 1, 500, 2)",
      "vars": {
        "input_tokens": 50
      },
      "expect_error": true
    },
    {
      "name": "tier_too_few_args",
      "expr": "tier(input_tokens, 100)",
      "vars": {
        "input_tokens": 50
      },
      "expect_error": true
    },
    {
      "name": "percentile_out_of_range",
      "expr": "percentile(150, 1, 2, 3)",
      "vars": {},
      "expect_error": true
    },
    {
      "name": "nested_max_ceil",
      "expr": "max(ceil(input_tokens * 0.001), 1)",
      "vars": {
        "input_tokens": 500
      },
      "expected": "1.000000"
    },
    {
      "name": "nested_clamp_round",
      "expr": "clamp(round(input_tokens * 0.0025), 0, 5)",
      "vars": {
        "input_tokens": 1000
      },
      "expected": "3.000000"
    },
    {
      "name": "quantize_underflow",
      "expr": "input_tokens * 0.00001",
      "vars": {
        "input_tokens": 1
      },
      "expected": "0.000010"
    },
    {
      "name": "quantize_half_up",
      "expr": "input_tokens * 0.000050",
      "vars": {
        "input_tokens": 1
      },
      "expected": "0.000050"
    }
  ],
  "pricing_cases": [
    {
      "name": "default_model",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * (0.01 / 1000) + output_tokens * (0.03 / 1000)"
          }
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "input_tokens": 500,
        "output_tokens": 200
      },
      "expected_total": "0.0110"
    },
    {
      "name": "fractional_total",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * 0.001"
          }
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "input_tokens": 1500
      },
      "expected_total": "1.5000"
    },
    {
      "name": "per_model_override",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "gpt-4": "input_tokens * 0.002",
            "*": "input_tokens * 0.001"
          }
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "input_tokens": 1000
      },
      "expected_total": "2.0000"
    },
    {
      "name": "tools_only",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * 0"
          },
          "tools": {
            "*": "calls * 0.01"
          }
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "tool_calls": [
          {
            "name": "t1"
          },
          {
            "name": "t2"
          },
          {
            "name": "t3"
          },
          {
            "name": "t4"
          },
          {
            "name": "t5"
          }
        ]
      },
      "expected_total": "0.0500"
    },
    {
      "name": "tools_with_model",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * 0.001"
          },
          "tools": {
            "*": "calls * 0.05"
          }
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "input_tokens": 1000,
        "tool_calls": [
          {
            "name": "t1"
          },
          {
            "name": "t2"
          }
        ]
      },
      "expected_total": "1.1000"
    },
    {
      "name": "cache_discount",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * 0.002"
          },
          "cache_discount": "cache_read_tokens * 0.0002"
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "input_tokens": 1000,
        "cache_read_tokens": 500
      },
      "expected_total": "1.9000"
    },
    {
      "name": "cache_discount_exceeds_cost",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * 0.001"
          },
          "cache_discount": "cache_read_tokens * 0.01"
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "input_tokens": 100,
        "cache_read_tokens": 100
      },
      "expected_total": "0.0000"
    },
    {
      "name": "search_costs",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * 0"
          },
          "search": "search_queries * 0.1"
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "search_queries": 3
      },
      "expected_total": "0.3000"
    },
    {
      "name": "fixed_cost",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * 0"
          },
          "flat_jobs": {
            "analysis_job": 5
          }
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "flat_job": "analysis_job"
      },
      "expected_total": "5.0000"
    },
    {
      "name": "model_plus_tools_plus_search",
      "config": {
        "version": 1,
        "metering": {
          "models": {
            "*": "input_tokens * 0.001"
          },
          "tools": {
            "*": "calls * 0.05"
          },
          "search": "search_queries * 0.1"
        },
        "ledger": {}
      },
      "metrics": {
        "model": "gpt-4",
        "input_tokens": 2000,
        "tool_calls": [
          {
            "name": "t1"
          },
          {
            "name": "t2"
          },
          {
            "name": "t3"
          }
        ],
        "search_queries": 2
      },
      "expected_total": "2.3500"
    }
  ]
}
