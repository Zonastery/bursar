{
  "$defs": {
    "AutoRechargeLimit": {
      "additionalProperties": false,
      "properties": {
        "max_purchases": {
          "minimum": 1,
          "title": "Max Purchases",
          "type": "integer"
        },
        "period": {
          "$ref": "#/$defs/Period"
        }
      },
      "required": [
        "max_purchases",
        "period"
      ],
      "title": "AutoRechargeLimit",
      "type": "object"
    },
    "AutoRechargePolicy": {
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "$ref": "#/$defs/AutoRechargeTrigger"
        },
        "purchase": {
          "$ref": "#/$defs/AutoRechargePurchase"
        },
        "limit": {
          "$ref": "#/$defs/AutoRechargeLimit"
        }
      },
      "required": [
        "trigger",
        "purchase",
        "limit"
      ],
      "title": "AutoRechargePolicy",
      "type": "object"
    },
    "AutoRechargePurchase": {
      "additionalProperties": false,
      "properties": {
        "topup": {
          "title": "Topup",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        }
      },
      "required": [
        "topup"
      ],
      "title": "AutoRechargePurchase",
      "type": "object"
    },
    "AutoRechargeTrigger": {
      "additionalProperties": false,
      "properties": {
        "balance_below": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Balance Below"
        }
      },
      "required": [
        "balance_below"
      ],
      "title": "AutoRechargeTrigger",
      "type": "object"
    },
    "BucketDefinition": {
      "additionalProperties": false,
      "properties": {
        "expires_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "BucketDefinition",
      "type": "object"
    },
    "CreditsConfig": {
      "additionalProperties": false,
      "properties": {
        "buckets": {
          "additionalProperties": {
            "$ref": "#/$defs/BucketDefinition"
          },
          "title": "Buckets",
          "type": "object"
        },
        "spend_order": {
          "items": {
            "type": "string"
          },
          "title": "Spend Order",
          "type": "array"
        },
        "default_bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Bucket"
        },
        "overdraft_bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overdraft Bucket"
        },
        "signup_grant": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignupGrant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CreditsConfig",
      "type": "object"
    },
    "DimensionMatcher": {
      "additionalProperties": false,
      "properties": {
        "exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        }
      },
      "title": "DimensionMatcher",
      "type": "object"
    },
    "FeatureLimit": {
      "additionalProperties": false,
      "properties": {
        "max_calls": {
          "minimum": 0,
          "title": "Max Calls",
          "type": "integer"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "action": {
          "default": "deny",
          "enum": [
            "deny",
            "warn",
            "notify"
          ],
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "max_calls",
        "period"
      ],
      "title": "FeatureLimit",
      "type": "object"
    },
    "IncludedCredits": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "reset": {
          "$ref": "#/$defs/Period"
        }
      },
      "required": [
        "amount",
        "reset"
      ],
      "title": "IncludedCredits",
      "type": "object"
    },
    "OperationDefinition": {
      "additionalProperties": false,
      "properties": {
        "measures": {
          "items": {
            "type": "string"
          },
          "title": "Measures",
          "type": "array"
        },
        "dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        }
      },
      "title": "OperationDefinition",
      "type": "object"
    },
    "OperationSpendingPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_concurrent": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Concurrent"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "strict",
                "overdraft"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "overdraft_limit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overdraft Limit"
        }
      },
      "title": "OperationSpendingPolicy",
      "type": "object"
    },
    "PaymentsConfig": {
      "additionalProperties": false,
      "properties": {
        "subscriptions": {
          "additionalProperties": {
            "$ref": "#/$defs/SubscriptionOffer"
          },
          "title": "Subscriptions",
          "type": "object"
        },
        "topups": {
          "additionalProperties": {
            "$ref": "#/$defs/TopupOffer"
          },
          "title": "Topups",
          "type": "object"
        },
        "auto_recharge": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoRechargePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PaymentsConfig",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ],
          "title": "Unit",
          "type": "string"
        },
        "count": {
          "default": 1,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "anchor": {
          "default": "calendar",
          "enum": [
            "calendar",
            "plan_assignment",
            "rolling"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "unit"
      ],
      "title": "Period",
      "type": "object"
    },
    "PlanDefinition": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "rate_card": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Card"
        },
        "included_credits": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncludedCredits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "features": {
          "additionalProperties": true,
          "title": "Features",
          "type": "object"
        },
        "limits": {
          "additionalProperties": {
            "$ref": "#/$defs/FeatureLimit"
          },
          "title": "Limits",
          "type": "object"
        },
        "spending": {
          "$ref": "#/$defs/SpendingPolicy"
        }
      },
      "required": [
        "display_name"
      ],
      "title": "PlanDefinition",
      "type": "object"
    },
    "PriceRule": {
      "additionalProperties": false,
      "properties": {
        "match": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/DimensionMatcher"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "title": "Default"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        }
      },
      "required": [
        "formula"
      ],
      "title": "PriceRule",
      "type": "object"
    },
    "ProviderLookup": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "ProviderLookup",
      "type": "object"
    },
    "ProviderReference": {
      "additionalProperties": false,
      "properties": {
        "lookup": {
          "$ref": "#/$defs/ProviderLookup"
        }
      },
      "required": [
        "lookup"
      ],
      "title": "ProviderReference",
      "type": "object"
    },
    "RateCard": {
      "additionalProperties": false,
      "properties": {
        "extends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extends"
        },
        "prices": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/PriceRule"
            },
            "type": "array"
          },
          "title": "Prices",
          "type": "object"
        }
      },
      "title": "RateCard",
      "type": "object"
    },
    "RenewalCredits": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "bucket": {
          "title": "Bucket",
          "type": "string"
        },
        "behavior": {
          "enum": [
            "replace",
            "accumulate"
          ],
          "title": "Behavior",
          "type": "string"
        },
        "on_subscription_end": {
          "enum": [
            "expire",
            "keep"
          ],
          "title": "On Subscription End",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "bucket",
        "behavior",
        "on_subscription_end"
      ],
      "title": "RenewalCredits",
      "type": "object"
    },
    "SignupGrant": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "bucket": {
          "title": "Bucket",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "bucket"
      ],
      "title": "SignupGrant",
      "type": "object"
    },
    "SpendingPolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "strict",
          "enum": [
            "strict",
            "overdraft"
          ],
          "title": "Mode",
          "type": "string"
        },
        "overdraft_limit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overdraft Limit"
        },
        "max_concurrent": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Concurrent"
        },
        "operations": {
          "additionalProperties": {
            "$ref": "#/$defs/OperationSpendingPolicy"
          },
          "title": "Operations",
          "type": "object"
        }
      },
      "title": "SpendingPolicy",
      "type": "object"
    },
    "SubscriptionOffer": {
      "additionalProperties": false,
      "properties": {
        "plan": {
          "title": "Plan",
          "type": "string"
        },
        "billing_period": {
          "$ref": "#/$defs/Period"
        },
        "providers": {
          "additionalProperties": {
            "$ref": "#/$defs/ProviderReference"
          },
          "title": "Providers",
          "type": "object"
        },
        "renewal_credits": {
          "anyOf": [
            {
              "$ref": "#/$defs/RenewalCredits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stack_credits": {
          "default": false,
          "title": "Stack Credits",
          "type": "boolean"
        }
      },
      "required": [
        "plan",
        "billing_period",
        "providers"
      ],
      "title": "SubscriptionOffer",
      "type": "object"
    },
    "TopupOffer": {
      "additionalProperties": false,
      "properties": {
        "credits": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Credits"
        },
        "bucket": {
          "title": "Bucket",
          "type": "string"
        },
        "providers": {
          "additionalProperties": {
            "$ref": "#/$defs/ProviderReference"
          },
          "title": "Providers",
          "type": "object"
        }
      },
      "required": [
        "credits",
        "bucket",
        "providers"
      ],
      "title": "TopupOffer",
      "type": "object"
    },
    "UsageConfig": {
      "additionalProperties": false,
      "properties": {
        "operations": {
          "additionalProperties": {
            "$ref": "#/$defs/OperationDefinition"
          },
          "title": "Operations",
          "type": "object"
        },
        "rate_cards": {
          "additionalProperties": {
            "$ref": "#/$defs/RateCard"
          },
          "title": "Rate Cards",
          "type": "object"
        }
      },
      "required": [
        "operations",
        "rate_cards"
      ],
      "title": "UsageConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "credits": {
      "$ref": "#/$defs/CreditsConfig"
    },
    "plans": {
      "additionalProperties": {
        "$ref": "#/$defs/PlanDefinition"
      },
      "title": "Plans",
      "type": "object"
    },
    "payments": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaymentsConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "BursarConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zonastery.github.io/bursar/pricing-config.schema.json"
}
